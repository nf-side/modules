nextflow_process {

    name "Test Process GFFREAD"
    script "../main.nf"
    process "GFFREAD"

    tag "gffread"
    tag "modules_nfcore"
    tag "modules"

    test("sarscov2-gff3-gtf") {

        config "./nextflow.config"

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    [],
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gff3", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll (
                { assert snapshot(
                    process.out.gtf,
                    process.out.gffread_gff,
                    process.out.gffread_fasta,
                    ['versions', process.out[3]]
                ).match() }
            )
        }
    }

    test("sarscov2-gff3-gtf-stub") {

        options '-stub'
        config "./nextflow.config"

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    [],
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gff3", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll (
                { assert snapshot(
                    process.out.gtf,
                    process.out.gffread_gff,
                    process.out.gffread_fasta,
                    ['versions', process.out[3]]
                ).match() }
            )
        }
    }

    test("sarscov2-gff3-gff3") {

        config "./nextflow-gff3.config"

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    [],
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gff3", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll (
                { assert snapshot(
                    process.out.gtf,
                    process.out.gffread_gff,
                    process.out.gffread_fasta,
                    ['versions', process.out[3]]
                ).match() }
            )
        }
    }

    test("sarscov2-gff3-gff3-stub") {

        options '-stub'
        config "./nextflow-gff3.config"

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    [],
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gff3", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll (
                { assert snapshot(
                    process.out.gtf,
                    process.out.gffread_gff,
                    process.out.gffread_fasta,
                    ['versions', process.out[3]]
                ).match() }
            )
        }
    }

    test("sarscov2-gff3-fasta") {

        config "./nextflow-fasta.config"

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta", checkIfExists: true),
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gff3", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll (
                { assert snapshot(
                    process.out.gtf,
                    process.out.gffread_gff,
                    process.out.gffread_fasta,
                    ['versions', process.out[3]]
                ).match() }
            )
        }
    }

    test("sarscov2-gff3-fasta-stub") {

        options '-stub'
        config "./nextflow-fasta.config"

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta", checkIfExists: true),
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gff3", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll (
                { assert snapshot(
                    process.out.gtf,
                    process.out.gffread_gff,
                    process.out.gffread_fasta,
                    ['versions', process.out[3]]
                ).match() }
            )
        }
    }

    test("sarscov2-gff3-fasta-fail-catch") {

        options '-stub'
        config "./nextflow-fasta.config"

        when {
            process {
                """
                input[0] = [
                    [id: 'genome'],
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta", checkIfExists: true),
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gff3", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.failed
            assertAll (
                { assert process.stdout.toString().contains("Input and output names are the same") }
            )
        }
    }
}
