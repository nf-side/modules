nextflow_process {

    name "Test Process KALLISTO_INDEX"
    script "../main.nf"
    process "KALLISTO_INDEX"
    tag "modules"
    tag "modules_nfcore"
    tag "kallisto"
    tag "kallisto/index"

    test("sarscov2 transcriptome.fasta") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'transcriptome' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    file(process.out.index[0][1]).name,
                    ['versions', process.out[1]]
                ).match() }
            )
        }
    }

    test("sarscov2 transcriptome.fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'transcriptome' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.index,
                    ['versions', process.out[1]]
                ).match() }
            )
        }
    }
}
